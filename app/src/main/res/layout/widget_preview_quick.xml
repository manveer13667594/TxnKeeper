<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the phone's widget list on Android 12 and newer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="176dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_preview_bar"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_button"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_preview_icon" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_button_focused"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic"
            android:tint="@color/widget_preview_icon_focused" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_button"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_camera"
            android:tint="@color/widget_preview_icon" />
    </LinearLayout>
</FrameLayout>
